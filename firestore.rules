rules_version = '2';

/**
 * Firestore-reglur Bekkjarins: allt lokað (nóvember 2026).
 *
 * Bekkjarforritið er lokað (sjá lib/closedRoutes.ts og CLAUDE.md). Firebase
 * Authentication er þó enn virkt og stillingar verkefnisins eru opinberar í
 * vafranum, svo hver sem er gæti skráð sig inn beint gegnum SDK. Eldri reglur
 * leyfðu hverjum innskráðum notanda að lesa öll `users` (netföng, síma,
 * heimilisföng), `students` (nöfn barna, fæðingardaga, ofnæmi) og `classes`
 * (með boðskóðum, líka `parentTeamCode`), og að breyta skráningum í `tasks`.
 *
 * Þess vegna er enginn aðgangur úr vafra að neinu skjali. Gögnin standa
 * óhreyfð og Admin SDK (scripts/syncAdmins.ts, firebase-admin) fer framhjá
 * reglunum eins og áður. Ofurstjórnendur (`system_admins`) fá ekki heldur
 * aðgang úr vafra: /admin er lokað.
 *
 * Eldri reglurnar eru í git-sögunni. Ekki setja þær aftur í loftið: þær eru
 * ekki öruggar. Ef nýtt safn bætist við (t.d. léttara röltkerfi) fær það
 * sínar eigin reglur hér fyrir ofan sjálfgefnu lokunina, með prófum í
 * tests-rules/.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
