rules_version = '2';

/**
 * Storage-reglur Bekkjarins: allt lokað (nóvember 2026).
 *
 * Bekkjarforritið er lokað. Eldri reglur leyfðu hverjum innskráðum notanda
 * að lesa myndir af notendum og börnum (`users/`, `students/`) og hlaða upp
 * myndum undir `students/` og `lost-found/` hvar sem er.
 *
 * Nú er enginn lestur eða skrif úr vafra. Skrárnar standa óhreyfðar.
 * Athugið: niðurhalsslóðir sem búnar voru til með getDownloadURL bera eigin
 * tóka og virka óháð þessum reglum. Til að gera þær óvirkar þarf að afturkalla
 * tókana í Firebase-stjórnborðinu.
 *
 * Eldri reglurnar eru í git-sögunni. Ekki setja þær aftur í loftið.
 */

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
